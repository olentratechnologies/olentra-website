  "website_controls": {
    "seed_file": "apps/admin/src/data/site-features.json",
    "runtime_file": ".data/site-features.json",
    "runtime_file_gitignored": true,
    "schema_version": 1,
    "store_path_environment_variable": "OLENTRA_FEATURE_STORE_PATH",
    "flags": [
      "services",
      "products",
      "internships",
      "blog",
      "assistant",
      "maintenance",
      "applications",
      "portal"
    ],
    "write_semantics": {
      "immediate_after_success": true,
      "review_required": false,
      "publish_required": false,
      "scheduled_override": false
    },
    "production": "Controls public website routes, sections, links and internship intake.",
    "staging": "Separate preview-only state; it does not affect the public Production website.",
    "portal": "Independent of public internship visibility. Existing portal access follows its own flag.",
    "intake": "The public program at /careers/intern and registration at /intern/register require the internships and applications flags for new intake.",
    "private_routes": [
      "/dashboard/**",
      "/intern/dashboard/**",
      "/intern/login",
      "/intern/reset-password"
    ],
    "api": {
      "read": "GET /api/site-features",
      "write": "PUT /api/site-features",
      "events": "GET /api/site-features/stream"
    },
    "delivery": "SSE updates open clients; polling fallback and focus refresh recover disconnected clients.",
    "enforcement": [
      "server proxy returns disabled-route 404 and maintenance 503",
      "client route gate updates already open pages",
      "Feature and link helpers remove disabled UI",
      "internship intake command guards",
      "dynamic sitemap omits disabled routes"
    ],
    "authentication": {
      "staff_bearer_token": true,
      "verification": "GET /intern/auth/session validates the account, session and current role against MongoDB.",
      "allowed": "Staff admin or workspace.administrator",
      "same_origin_required": true,
      "environment_variables": [
        "NEXT_PUBLIC_INTERNSHIP_BACKEND_URL",
        "INTERNSHIP_BACKEND_URL",
        "OLENTRA_FEATURE_SITE_ORIGIN"
      ]
    },
    "deployment": "Persistent Node filesystem deployment with a mounted durable volume. Separate replica files are not a distributed shared database.",
    "browser_reset_does_not_reset_live_switches": true,
    "public_internship_route": "/careers/intern",
    "legacy_public_internship_route": {
      "path": "/intern",
      "destination": "/careers/intern",
      "enabled_status": 308,
      "disabled_status": 404,
      "preserves_query_parameters": true
    }
  },
  "authentication": [
    "/dashboard/login",
