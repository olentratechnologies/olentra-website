{
  "name": "olentra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend:install": "npm install --prefix frontend",
    "dev": "npm --prefix frontend run dev",
    "dev:all": "node scripts/run-services.mjs dev",
    "build": "npm --prefix frontend run build",
    "build:all": "node scripts/build-all.mjs",
    "compile:all": "npm run build:all",
    "start": "npm --prefix frontend run start",
    "start:all": "node scripts/run-services.mjs start",
    "lint": "npm --prefix frontend run lint",

    "email:dev": "bun run --cwd backend/email-server dev",
    "email:start": "bun run --cwd backend/email-server start",
    "email:test": "bun run --cwd backend/email-server test",
    "email:typecheck": "bun run --cwd backend/email-server typecheck",
    "contact:dev": "npm run email:dev",
    "contact:start": "npm run email:start",
    "contact:test": "npm run email:test",

    "realtime:dev": "bun run --cwd backend/realtime-server dev",
    "realtime:start": "bun run --cwd backend/realtime-server start",
    "realtime:test": "bun run --cwd backend/realtime-server test",
    "realtime:typecheck": "bun run --cwd backend/realtime-server typecheck",
    "realtime:bench": "bun run --cwd backend/realtime-server bench",
    "presence:dev": "npm run realtime:dev",
    "presence:start": "npm run realtime:start",
    "presence:test": "npm --prefix frontend run test:presence && npm run realtime:test",
    "presence:bench": "bun run --cwd backend/realtime-server bench:presence",

    "internship:dev": "npm run realtime:dev",
    "internship:start": "npm run realtime:start",
    "internship:test": "node scripts/run-internship-tests.mjs",
    "internship:bench": "bun run --cwd backend/realtime-server bench",
    "internship:bench:latency": "bun run --cwd backend/realtime-server bench:latency",
    "internship:bootstrap": "bun run --cwd backend/realtime-server bootstrap",
    "internship:promote-admin": "bun run --cwd backend/realtime-server promote-admin",

    "intern:dev": "npm run internship:dev",
    "intern:start": "npm run internship:start",
    "intern:test": "npm run internship:test",
    "intern:bench": "npm run internship:bench",
    "intern:bench:latency": "npm run internship:bench:latency",
    "intern:bootstrap": "npm run internship:bootstrap",
    "intern:promote-admin": "npm run internship:promote-admin",

    "test:admin": "npm --prefix frontend run test:admin",
    "test:naming": "node --test scripts/naming-and-routes.test.mjs",
    "test:services": "node --test scripts/run-services.test.mjs scripts/service-restart.test.mjs",
    "test:all": "npm run email:test && npm run presence:test && npm run internship:test && npm run test:admin && npm run test:naming && npm run test:services"
  }
}
