# Website (apps/web) runtime configuration.
# Copy this file to apps/web/.env.local for local development.

# Contact form proxy to backend/email-server (server-only; never expose the token).
# CONTACT_BACKEND_TOKEN must equal the email server's CONTACT_BACKEND_TOKEN.
CONTACT_BACKEND_URL=http://127.0.0.1:3001
CONTACT_BACKEND_TOKEN=
CONTACT_SITE_ORIGIN=http://localhost:3000

# Browser-facing endpoints of backend/realtime-server.
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:3003/ws
NEXT_PUBLIC_INTERNSHIP_BACKEND_URL=http://localhost:3003

# Optional settings (defaults shown).
# Company workspace (apps/admin) origin; /dashboard links on the website redirect here.
# OLENTRA_ADMIN_URL=http://localhost:3002
# Canonical public origin used for redirects; derived from the request when unset.
# OLENTRA_FEATURE_SITE_ORIGIN=https://www.olentratechnologies.com
# Shared feature-switch file written by the company workspace and read here.
# OLENTRA_FEATURE_STORE_PATH=<repo>/.data/site-features.json
# Set to false to disable smooth scrolling site-wide.
# NEXT_PUBLIC_SMOOTH_SCROLL_ENABLED=true
