# Company workspace (apps/admin) runtime configuration.
# Copy this file to apps/admin/.env.local for local development.

# The public website (apps/web); "View website" and preview links use this origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-facing realtime presence endpoint (live user count).
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:3003/ws

# Website-controls sign-in. Required in production (configure in your host, never commit):
# the password needs at least 12 characters, and the session secret must be a long
# random value shared by every instance. Locally, leave them unset to use the
# built-in localhost demo session.
# OLENTRA_FEATURE_ADMIN_EMAIL=owner@example.com
# OLENTRA_FEATURE_ADMIN_PASSWORD=
# OLENTRA_FEATURE_SESSION_SECRET=
# OLENTRA_FEATURE_ADMIN_MFA_CODE=

# Optional settings (defaults shown).
# Admin origin for the same-origin check; set once the admin domain is attached.
# OLENTRA_FEATURE_SITE_ORIGIN=https://admin.olentratechnologies.com
# Allow the localhost demo session outside development (keep false in production).
# OLENTRA_FEATURE_ALLOW_LOCAL_DEMO=false
# Shared feature-switch file; must be the same file the website reads.
# OLENTRA_FEATURE_STORE_PATH=<repo>/.data/site-features.json
