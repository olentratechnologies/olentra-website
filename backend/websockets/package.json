{
  "name": "websockets-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns '**/intern/**' src/presence.test.ts server.test.ts",
    "bench": "bun bench-presence.ts",
    "intern:dev": "bun --watch src/intern/index.ts",
    "intern:start": "bun src/intern/index.ts",
    "intern:bootstrap": "bun src/intern/bootstrap.ts",
    "intern:promote-admin": "bun src/intern/promote-admin.ts",
    "test:intern": "bun test src/intern",
    "bench:intern": "bun src/intern/bench.ts",
    "bench:intern:latency": "bun src/intern/latency-bench.ts"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "mongodb": "^7.8.0"
  }
}
