PORT=3002
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.olentratechnologies.com,https://olentratechnologies.com


# Latest-count updates are coalesced; no periodic fanout when nothing changes.
PRESENCE_BROADCAST_INTERVAL_MS=100
# Optional startup/handler diagnostics; no per-connection logging.
PRESENCE_LOG=false

# Internship service (keep credentials in your local .env, never commit them).
MONGODB_URI=
INTERN_JWT_SECRET=
INTERN_HOST=127.0.0.1
INTERN_PORT=3003
INTERN_SITE_ORIGIN=http://localhost:3000
INTERN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESEND_API_KEY=
INTERN_SENDER_EMAIL=Olentra Careers <website@olentratechnologies.com>
