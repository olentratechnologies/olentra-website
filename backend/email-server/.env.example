# Contact email service (backend/email-server).
PORT=3001
HOST=127.0.0.1

# Resend delivery. All four values are required in production.
RESEND_API_KEY=
CONTACT_SENDER_EMAIL=Olentra Website <website@olentratechnologies.com>
CONTACT_RECEIVER_EMAIL=contact@olentratechnologies.com
# Shared secret; must equal CONTACT_BACKEND_TOKEN in apps/web.
CONTACT_BACKEND_TOKEN=
