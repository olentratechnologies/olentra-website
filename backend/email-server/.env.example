# Central email delivery service. Only this service holds Google credentials.
PORT=3001
HOST=127.0.0.1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional; defaults to SMTP_USER. Use that mailbox or an authorized Google alias.
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=contact@olentratechnologies.com
# Must match apps/web CONTACT_BACKEND_TOKEN.
CONTACT_BACKEND_TOKEN=
# Private service secret; must match realtime-server EMAIL_DELIVERY_TOKEN.
EMAIL_DELIVERY_TOKEN=
