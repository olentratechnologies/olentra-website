# Unified realtime service (backend/realtime-server): presence and internship.
REALTIME_PORT=3003
REALTIME_HOST=0.0.0.0
# Browser origins allowed to connect: the website (3000) and the company workspace (3002).
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
# Only enable behind a trusted reverse proxy that overwrites forwarded-IP headers.
# REALTIME_TRUST_PROXY=false
# Set with NEXT_PUBLIC_INTERNSHIP_TURNSTILE_SITE_KEY on the web app to require verified resume uploads.
# INTERNSHIP_TURNSTILE_SECRET_KEY=

# Presence runtime.
PRESENCE_BROADCAST_INTERVAL_MS=100
PRESENCE_LOG=false

# MongoDB Atlas replica-set connection string for internship modules.
# Leave empty to keep presence available while internship initialization retries.
INTERNSHIP_MONGODB_URI=

# JWT secret: at least 32 random bytes, required in production.
# Leave empty in development; a secret is generated in .data/intern-jwt-secret.
INTERNSHIP_JWT_SECRET=

# Central email-server delivery for internship messages.
EMAIL_SERVER_URL=http://127.0.0.1:3001
EMAIL_DELIVERY_TOKEN=

# Website origin (apps/web) used to build sign-in and verification links in emails.
INTERNSHIP_SITE_ORIGIN=http://localhost:3000

# Company workspace origin (apps/admin) used for staff set/reset-password links.
INTERNSHIP_WORKSPACE_ORIGIN=http://localhost:3002

# Isolated integration-test, bootstrap and benchmark settings.
# Never point these at a production or shared application database.
# INTERNSHIP_TEST_MONGODB_URI=
# INTERNSHIP_TEST_STAFF_EMAIL=staff@example.test
# INTERNSHIP_TEST_STAFF_PASSWORD=
# INTERNSHIP_INITIAL_ADMIN_EMAIL=staff@example.test
# Dev-only logins created by `bun run seed:test` (emails must end in .test).
# INTERNSHIP_TEST_INTERN_EMAIL=intern@olentra.test
# INTERNSHIP_TEST_INTERN_PASSWORD=
# INTERNSHIP_TEST_RECRUITER_EMAIL=recruiter@olentra.test
# INTERNSHIP_TEST_RECRUITER_PASSWORD=
# INTERNSHIP_BENCH_SAMPLES=8

# Deprecated aliases (INTERNSHIP_PORT, INTERN_*, PORT, HOST, ALLOWED_ORIGINS, MONGODB_URI,
# SITE_ORIGIN, ...) still work for one compatibility cycle but log a warning; use the names above.

# Direct uploads: opt in only after workload IAM and a private ClamAV service are ready.
INTERNSHIP_FILE_STORAGE=gridfs
# Production OCI configuration (required when INTERNSHIP_FILE_STORAGE=oci)
# OCI_STORAGE_NAMESPACE=your-namespace
# OCI_STORAGE_REGION=ap-hyderabad-1
# OCI_STORAGE_BUCKET=olentrainternship
# OCI_QUARANTINE_BUCKET=olentrainternship-quarantine
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# Malware scanning defaults to clamav. Explicitly opt out for a launch without scanning:
# INTERNSHIP_FILE_SCAN_MODE=disabled
# Production authentication: instance principals (automatic on OCI Compute)
# No OCI_AUTH_MODE or OCI_CLI_PROFILE needed in production
# Local development only:
# OCI_AUTH_MODE=session
# OCI_CLI_PROFILE=OLENTRA
# Persistent API signing key authentication (local or hosted backend):
# OCI_AUTH_MODE=api_key
# OCI_TENANCY_OCID=ocid1.tenancy.oc1...
# OCI_USER_OCID=ocid1.user.oc1...
# OCI_FINGERPRINT=aa:bb:...
# OCI_PRIVATE_KEY_FILE=/absolute/path/to/oci_api_key.pem
# Or supply OCI_PRIVATE_KEY as a PEM string with escaped \n newlines.
# OCI_PRIVATE_KEY_PASSPHRASE=  # only for encrypted keys
