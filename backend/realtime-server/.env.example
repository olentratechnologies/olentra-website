# Unified realtime service (backend/realtime-server): presence and internship.
REALTIME_PORT=3003
REALTIME_HOST=0.0.0.0
# Browser origins allowed to connect: the website (3000) and the company workspace (3002).
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# Presence runtime.
PRESENCE_BROADCAST_INTERVAL_MS=100
PRESENCE_LOG=false

# MongoDB Atlas replica-set connection string for internship modules.
# Leave empty to keep presence available while internship initialization retries.
INTERNSHIP_MONGODB_URI=

# JWT secret: at least 32 random bytes, required in production.
# Leave empty in development; a secret is generated in .data/intern-jwt-secret.
INTERNSHIP_JWT_SECRET=

# Resend email for internship messages.
RESEND_API_KEY=
INTERNSHIP_SENDER_EMAIL=Olentra Careers <website@olentratechnologies.com>

# Website origin (apps/web) used to build sign-in and verification links in emails.
INTERNSHIP_SITE_ORIGIN=http://localhost:3000

# Isolated integration-test, bootstrap and benchmark settings.
# Never point these at a production or shared application database.
# INTERNSHIP_TEST_MONGODB_URI=
# INTERNSHIP_TEST_STAFF_EMAIL=staff@example.test
# INTERNSHIP_TEST_STAFF_PASSWORD=
# INTERNSHIP_INITIAL_ADMIN_EMAIL=staff@example.test
# INTERNSHIP_BENCH_SAMPLES=8

# Deprecated aliases (INTERNSHIP_PORT, INTERN_*, PORT, HOST, ALLOWED_ORIGINS, MONGODB_URI,
# SITE_ORIGIN, ...) still work for one compatibility cycle but log a warning; use the names above.
