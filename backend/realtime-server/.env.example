# Unified realtime listener. Presence and internship use this one process.
REALTIME_PORT=3003
REALTIME_HOST=0.0.0.0
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
# Presence runtime
PRESENCE_BROADCAST_INTERVAL_MS=100
PRESENCE_LOG=false

# Deprecated listener configuration aliases; keep for one compatibility cycle.
# INTERNSHIP_PORT=3003
# INTERNSHIP_HOST=0.0.0.0
# INTERNSHIP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# INTERN_PORT=3003
# INTERN_HOST=0.0.0.0
# INTERN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PORT=3003
# HOST=0.0.0.0
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas replica-set connection string for internship modules.
# Leave empty to keep presence available while internship initialization retries.
INTERNSHIP_MONGODB_URI=
# Deprecated compatibility aliases: MONGODB_URI and MONGODB.

# JWT secret – at least 32 random bytes in production.
# Leave empty in development; a secret is auto-generated in .data/intern-jwt-secret.
INTERNSHIP_JWT_SECRET=
# Deprecated compatibility alias: INTERN_JWT_SECRET

# Resend email configuration.
RESEND_API_KEY=
INTERNSHIP_SENDER_EMAIL=Olentra Careers <website@olentratechnologies.com>
# Deprecated compatibility alias: INTERN_SENDER_EMAIL

# Origin of the Next.js frontend for site-feature checks.
INTERNSHIP_SITE_ORIGIN=http://localhost:3000
# Deprecated compatibility aliases: INTERN_SITE_ORIGIN and SITE_ORIGIN

# Explicitly isolated integration-test and benchmark settings.
# Do not point these at a production or shared application database.
# INTERNSHIP_TEST_MONGODB_URI=
# INTERNSHIP_TEST_STAFF_EMAIL=staff@example.test
# INTERNSHIP_TEST_STAFF_PASSWORD=
# INTERNSHIP_INITIAL_ADMIN_EMAIL=staff@example.test
# INTERNSHIP_BENCH_SAMPLES=8
